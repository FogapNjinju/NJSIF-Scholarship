CLIENT_ORIGIN=http://localhost:3000
PORT=5000
# Free MongoDB Atlas database used by production deployments.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/njsif-scholarship
# Use Cloudinary for permanent uploads in Render or other hosted environments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Persist application uploads and CSV data across restarts. Use a mounted volume or a
# dedicated folder that survives server restarts and redeploys.
PERSISTENT_DIR=./persistent-data
